let count = 0
for py = 0 to 300 {
    for px = 0 to 300 {
        let x0 = px / 150.0 - 2.5
        let y0 = py / 150.0 - 1.25
        let x = 0.0
        let y = 0.0
        let iter = 0
        let escaped = false
        while iter < 50 {
            let x2 = x * x
            let y2 = y * y
            if x2 + y2 > 4.0 { escaped = true; iter = 50 }
            let xt = x2 - y2 + x0
            y = 2.0 * x * y + y0
            x = xt
            iter = iter + 1
        }
        if escaped { count = count + 1 }
    }
}
print(count)
