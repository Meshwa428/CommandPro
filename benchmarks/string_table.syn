let words = "the quick brown fox jumps over the lazy dog the fox runs quick brown dog jumps over lazy fox".split(" ")
let counts = {}
let n = 20000
let total = 0
let i = 0
while i < n {
    let idx = i % len(words)
    let w = words[idx]
    if w in counts {
        counts[w] = counts[w] + 1
    } else {
        counts[w] = 1
    }
    i = i + 1
}
for w in words {
    total = total + counts[w]
}
say(total)
