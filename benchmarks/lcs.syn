let m = 500
let n = 480
let a = []
let b = []
for i = 0 to m { append(a, i % 26) }
for i = 0 to n { append(b, (i * 5 + 3) % 26) }
let w = n + 1
let dp = []
for k = 0 to (m + 1) * w { append(dp, 0) }
for i = 1 to m + 1 {
    for j = 1 to n + 1 {
        if a[i-1] == b[j-1] {
            dp[i*w+j] = dp[(i-1)*w+(j-1)] + 1
        } else {
            let u = dp[(i-1)*w+j]
            let v = dp[i*w+(j-1)]
            if u >= v { dp[i*w+j] = u } else { dp[i*w+j] = v }
        }
    }
}
say(dp[m*w+n])
