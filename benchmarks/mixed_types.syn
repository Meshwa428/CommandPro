let n = 30000
let int_total = 0
let float_total = 0.0
let str_len_total = 0
let list_total = 0
let cache = {}
let i = 0
while i < n {
    int_total = int_total + i
    float_total = float_total + i * 1.5
    let s = "n{i}"
    str_len_total = str_len_total + len(s)
    let xs = [i, i + 1]
    list_total = list_total + xs[0] + xs[1]
    let k = i % 100
    if k in cache {
        cache[k] = cache[k] + 1
    } else {
        cache[k] = 1
    }
    i = i + 1
}
let cache_total = 0
let j = 0
while j < 100 {
    cache_total = cache_total + cache[j]
    j = j + 1
}
say(int_total)
say(float_total)
say(str_len_total)
say(list_total)
say(cache_total)
