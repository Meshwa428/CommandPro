# RAT mouse demo — watch the cursor move like a human hand.
# Run it:  ./build/release/syn examples/rat_demo.syn
# (moves your real cursor; keep hands off the mouse while it runs)
#
# Coordinates assume a ~1920x1080 screen. Lower them if yours is smaller.

say "RAT mode: human-like trajectories (curved, variable speed, tiny overshoot)"
mouse.mode("rat")

# Trace a rectangle. Each move routes through RAT, so it curves and eases
# instead of snapping in a straight line. The waits let you watch each one.
repeat 2 {
    mouse 400, 300
    wait 600ms
    mouse 1400, 300
    wait 600ms
    mouse 1400, 800
    wait 600ms
    mouse 400, 800
    wait 600ms
}

say ""
say "Linear mode: straight line, constant speed (what every other bot does)"
mouse.mode("linear")
repeat 2 {
    mouse 400, 300
    wait 600ms
    mouse 1400, 800
    wait 600ms
}

# Back to RAT and show the numbers the model predicts for a move, without
# actually moving (preview returns {duration_ms, waypoints}).
mouse.mode("rat")
say ""
let p = mouse.preview(1400, 800)
say "preview move to 1400,800:  {p.duration_ms} ms over {p.waypoints} waypoints"

# Speed knob: 2x faster, then a slow, deliberate move.
say ""
say "speed 2.0 (fast) then 0.5 (slow) — same distance, different duration"
mouse.speed(2.0)
mouse 400, 300
wait 500ms
mouse.speed(0.5)
mouse 1400, 800
wait 500ms

say ""
say "done"
