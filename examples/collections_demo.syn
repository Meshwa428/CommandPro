# List demo
let fruits = ["apple", "banana", "cherry"];
println "Fruits: " + fruits;
println "First fruit: " + fruits[0];

# Map demo
let person = {
    "name": "Meshwa",
    "role": "Developer",
    "skills": ["C++", "Synapse"]
};

println "Person: " + person;
println "Name: " + person["name"];
println "First skill: " + person["skills"][0];

# Nested demo
let matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
];
println "Matrix row 1: " + matrix[1];
println "Matrix [1][1]: " + matrix[1][1];

# String indexing
let text = "Hello";
println "First char of Hello: " + text[0];
