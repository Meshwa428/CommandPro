let start = now();
# 2. Stack Churn Benchmark
let i = 0;
loop while (i < 100000) {
    let x = (((((i + 1) * 2) - 3) / 4) % 5);
    i = i + 1;
}
let end = now();
println "RESULT:" + (end - start);
