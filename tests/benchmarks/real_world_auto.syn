let start = now();
# Mixed Real-World Automation Benchmark
fn findAndClick(targetName) {
    let apps = app_list();
    let i = 0;
    loop while (i < size(apps)) {
        if (apps[i] == targetName) {
            # Simulated find
            return true;
        }
        i = i + 1;
    }
    return false;
}

let i = 0;
loop while (i < 1000) {
    findAndClick("Browser");
    let pos = get_mouse_pos();
    # Simulate interaction
    let x = pos[0] + 1;
    let y = pos[1] + 1;
    i = i + 1;
}
let end = now();
println "RESULT:" + (end - start);
