# test: features/comprehensions
let xs = [1, 2, 3, 4, 5]
say([x * 2 for x in xs])
# expect: [2, 4, 6, 8, 10]
say([x for x in xs if x % 2 == 1])
# expect: [1, 3, 5]
say([x + y for x in [1, 2] for y in [10, 20]])
# expect: [11, 21, 12, 22]
let m = {"a": 1, "b": 2}
say([k for k, v in m])
# expect: [a, b]
let sq = {x: x * x for x in [1, 2, 3]}
say(sq[2], sq[3])
# expect: 4 9
let inv = {v: k for k, v in m}
say(inv[1], inv[2])
# expect: a b
let big = {k: v for k, v in m if v > 1}
say(big["b"])
# expect: 2
