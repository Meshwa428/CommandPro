# Math Precision & Edge Cases

# 1. Floating point
let f1 = 0.1;
let f2 = 0.2;
let f3 = f1 + f2;
# Standard float precision issue (0.30000000000000004)
# But we can check if it's close to 0.3
if (f3 > 0.29 and f3 < 0.31) { println "Float math OK"; }

# 2. Modulo with negatives
if (-5 % 3 == -2) { println "Negative modulo OK"; }

# 3. Big exponents
let big = 2**10; # 1024
if (big == 1024) { println "Exponent OK"; }

# 4. Division by zero (Expected Error)
# let fail = 10 / 0; # Handled in individual test
