# @EXPECT EXIT 0
# @EXPECT STDOUT "Recursion Sum 100 OK"
# @EXPECT STDOUT "Mutual Recursion OK"
# Recursion Stress

fn sum_to(n) {
    if (n == 0) { return 0; }
    return n + sum_to(n - 1);
}

if (sum_to(100) == 5050) { println "Recursion Sum 100 OK"; }

fn is_even(n) {
    if (n == 0) { return true; }
    return is_odd(n - 1);
}

fn is_odd(n) {
    if (n == 0) { return false; }
    return is_even(n - 1);
}

if (is_even(50)) { println "Mutual Recursion OK"; }
