# @EXPECT EXIT 0
# @EXPECT STDOUT "Math OK"
# @EXPECT STDOUT "Nested OK"
# @EXPECT STDOUT "Fib 10 OK"
# Heavy Duty Integration Test

# 1. Complex Math & Logic
let a = 10;
let b = 20;
let c = 30;
let res = (a + b) * c / (b - a) + 2**3;
# (30 * 30) / 10 + 8 = 90 + 8 = 98
if (res == 98) { println "Math OK"; } else { println "Math FAIL: " + res; }

# 2. Nested Loops & Conditionals
let count = 0;
let i = 0;
loop while (i < 5) {
    let j = 0;
    repeat 3 times {
        if (i % 2 == 0) {
            count = count + 1;
        } else {
            count = count + 2;
        }
        j = j + 1;
    }
    i = i + 1;
}
# i=0 (even): count += 1 * 3 = 3
# i=1 (odd):  count += 2 * 3 = 6 (total 9)
# i=2 (even): count += 1 * 3 = 3 (total 12)
# i=3 (odd):  count += 2 * 3 = 6 (total 18)
# i=4 (even): count += 1 * 3 = 3 (total 21)
if (count == 21) { println "Nested OK"; } else { println "Nested FAIL: " + count; }

# 3. String Manipulation & Collections
let myList = [1, 2, 3];
let sum = 0;
# We don't have for-each yet, so use while
let k = 0;
loop while (k < 3) {
    sum = sum + myList[k];
    k = k + 1;
}
if (sum == 6) { println "List access OK"; }

let myMap = {"name": "Synapse", "version": 1.0};
if (myMap["name"] == "Synapse") { println "Map access OK"; }

# 4. Recursion Stress
fn fib(n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}
if (fib(10) == 55) { println "Fib 10 OK"; }
