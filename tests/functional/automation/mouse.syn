# @EXPECT EXIT 0
# @EXPECT STDOUT "MOUSE_TEST_OK"
# @EXPECT STDOUT "[MOCK] MOUSE_MOVE 100 100"
# @EXPECT STDOUT "[MOCK] MOUSE_MOVE 300 250"
# Mouse Automation Test with Factuality Verification

# Move to a specific point
let target1 = (100, 100);
MOUSE MOVE TO target1;

# Verify move
let pos1 = get_mouse_pos();
assert(pos1 == target1, "Failed to move mouse to (100, 100). Got " + pos1);

# Move to another point
let target2 = (300, 250);
MOUSE MOVE TO target2;

# Verify move
let pos2 = get_mouse_pos();
assert(pos2 == target2, "Failed to move mouse to (300, 250). Got " + pos2);

println "MOUSE_TEST_OK";
